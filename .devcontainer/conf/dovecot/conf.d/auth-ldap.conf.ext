ldap_auth_dn = cn=admin,dc=example,dc=org
ldap_auth_dn_password = password
ldap_base = dc=example,dc=org
ldap_uris = ldap://openldap:390
ldap_version = 3



passdb ldap {
  #Passwords only, the SSO access tokens (xoauth2, oauthbearer) are checked by passdb oauth2
  mechanisms_filter = plain login
  ldap_bind = yes
  ldap_filter = (&(objectClass=posixAccount)(uid=%{user}))

  fields {
    # user=%{ldap:uid}
    # password=%{ldap:userPassword}
    # userdb_home=/home/mail/%{ldap:uid}
    #userdb_uid=%{ldap:uidNumber}
    #userdb_gid=%{ldap:gidNumber}
  }
}

userdb ldap {
  ldap_filter = (|(uid=%{user})(mail=%{user}))
  #fields {
  #  home=/home/mail/%{username}
  #}
}